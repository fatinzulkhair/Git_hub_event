{
  "rules": [
    {
      "rule_id": "PRD-A-MANDATORY-PROPERTIES",
      "validation_type": "Product Master Data - Mandatory properties",
      "description": "Every product needs ProductTypeCode, InextorPackPrint and InextorOuterPrint, not empty",
      "severity": "Critical",
      "active": "Y",
      "on_exception_status": -1,
      "on_exception_description": "Mandatory product properties are missing"
    }
  ],
  "conditions": [
    {
      "rule_id": "PRD-A-MANDATORY-PROPERTIES",
      "role": "Target",
      "field_name": "ProductProperties.ProductTypeCode",
      "data_type": "Exist"
    },
    {
      "rule_id": "PRD-A-MANDATORY-PROPERTIES",
      "role": "Target",
      "field_name": "ProductProperties.InextorPackPrint",
      "data_type": "Exist"
    },
    {
      "rule_id": "PRD-A-MANDATORY-PROPERTIES",
      "role": "Target",
      "field_name": "ProductProperties.InextorOuterPrint",
      "data_type": "Exist"
    }
  ]
}
